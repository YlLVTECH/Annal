{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notebook",
  "version": "0.2.0",
  "identifier": "com.notebook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "笔记本",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "backgroundColor": "#f6f6f4"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/icon-transparent_32x32.png",
      "icons/icon-transparent_128x128.png",
      "icons/icon-transparent_256x256.png",
      "icons/icon-light_32x32.png",
      "icons/icon-light_128x128.png",
      "icons/icon-light_256x256.png"
    ]
  }
}
