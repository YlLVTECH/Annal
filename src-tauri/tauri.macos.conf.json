{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "笔记本",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f6f6f4",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 12 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"]
  }
}
